          "inputSchema": {
            "type": "object",
            "properties": {}
          }
        }
      ],
      "metadata": {
        "agent": "config_optimizer",
        "capabilities": [
          "config",
          "configuration",
          "settings",
          "env",
          "environment",
          "setup",
          "optimize"
        ],
        "priority": 55
      }
    },
