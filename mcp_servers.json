{
  "mcpServers": {
    "ai-orchestrator-code_analyzer": {
      "command": "python",
      "args": [
        "-m",
        "ai_orchestrator",
        "--mcp-server",
        "code_analyzer"
      ],
      "tools": [
        {
          "name": "analyze_code",
          "description": "Perform static analysis on code files",
          "inputSchema": {
            "type": "object",
            "properties": {
              "file_path": {
                "type": "string",
                "description": "File or directory to analyze"
              }
            }
          }
        }
      ],
      "metadata": {
        "agent": "code_analyzer",
        "capabilities": [
          "code_analysis",
          "static_analysis",
          "ast",
          "complexity",
          "structure",
          "inspect"
        ],
        "priority": 85
      }
    },
    "ai-orchestrator-config_optimizer": {
      "command": "python",
      "args": [
        "-m",
        "ai_orchestrator",
        "--mcp-server",
